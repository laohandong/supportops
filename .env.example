# Copy to .local/model.env for node scripts/start.mjs or node scripts/evaluate.mjs.
# Storage is required; see docs/deployment.md. For bundled Compose defaults use node scripts/setup-local.mjs.
SUPPORTOPS_DB_URL=jdbc:mysql://127.0.0.1:13306/supportops?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
SUPPORTOPS_DB_USER=supportops
SUPPORTOPS_DB_PASSWORD=
SUPPORTOPS_EXCEL_SCHEMA=supportops_excel
SUPPORTOPS_EXCEL_QUERY_USER=supportops_reader
SUPPORTOPS_EXCEL_QUERY_PASSWORD=
SUPPORTOPS_MINIO_ENDPOINT=http://127.0.0.1:19000
SUPPORTOPS_MINIO_ACCESS_KEY=
SUPPORTOPS_MINIO_SECRET_KEY=
SUPPORTOPS_MINIO_BUCKET=supportops
SUPPORTOPS_ES_ENDPOINT=http://127.0.0.1:19200
SUPPORTOPS_ES_USER=
SUPPORTOPS_ES_PASSWORD=
SUPPORTOPS_ES_PREFIX=supportops
# Java/Maven launches read process environment variables; they do not load this file.
# Empty entries preserve values from the calling shell; non-empty file entries take precedence.
# Provider: bailian (default), deepseek, openai, custom, or an entry in .local/providers.yml.
SUPPORTOPS_MODEL_PROVIDER=
# Leave blank to use the selected provider's default model and endpoint.
SUPPORTOPS_MODEL=
SUPPORTOPS_MODEL_BASE_URL=
# Fill only the key of the provider you use. Unselected providers require no keys.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional role-specific credential override, independent of the provider key above.
SUPPORTOPS_API_KEY=
SUPPORTOPS_MODEL_API_KEY_ENV=
# Embeddings are independent and optional: bailian (default), openai, custom, or disabled.
SUPPORTOPS_EMBEDDING_PROVIDER=
SUPPORTOPS_EMBEDDING_API_KEY=
SUPPORTOPS_EMBEDDING_API_KEY_ENV=
SUPPORTOPS_EMBEDDING_BASE_URL=
SUPPORTOPS_EMBEDDING_MODEL=
# Local ONNX reranking: explicit opt-in; files stay outside the application JAR.
SUPPORTOPS_RERANK_ENABLED=false
SUPPORTOPS_RERANK_MODEL_PATH=.local/models/reranker/model_quantized.onnx
SUPPORTOPS_RERANK_TOKENIZER_PATH=.local/models/reranker/tokenizer.json
SUPPORTOPS_RERANK_CANDIDATES=20
SUPPORTOPS_RERANK_MAX_INPUT_TOKENS=512
SUPPORTOPS_RERANK_THREADS=2
SUPPORTOPS_RERANK_TIMEOUT_MS=30000
