{
  "openapi": "3.0.1",
  "info": {
    "title": "SupportOps 应用诊断 API",
    "version": "1.0",
    "description": "单企业独立部署的应用身份接口；实际服务地址由部署者提供。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/open-api/v1/diagnoses": {
      "post": {
        "tags": [
          "开放诊断 API V1"
        ],
        "summary": "受理独立诊断",
        "description": "固定 requestId；问题1至6000字符；unknown字段拒绝。首次202、重放200、异参409；响应丢失查询原请求",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenDiagnosisCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "run、目标、固定回执已提交；任务异步执行",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "请求参数或 JSON 格式不正确。INVALID_INPUT：字段类型、必填参数或请求体无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "INVALID_INPUT"
                }
              }
            }
          },
          "401": {
            "description": "应用密钥缺失、失效、过期或已撤销；Cookie 不能替代",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "403": {
            "description": "应用权限或环境授权不足",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "404": {
            "description": "本应用无该请求、任务或证据",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED：该路径不支持此请求方式，请按接口定义使用 GET 或 POST。Allow 响应头列出路径支持的方法。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "METHOD_NOT_ALLOWED"
                }
              }
            }
          },
          "409": {
            "description": "同键异参或目标未启用",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "429": {
            "description": "速率、应用活动任务或全局环境容量不足",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR：操作失败。可能包括存储故障或已选择的外部向量服务调用失败；不会返回服务商原始错误信息或伪造成功结果。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "INTERNAL_ERROR"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApplicationBearer": []
          }
        ]
      }
    },
