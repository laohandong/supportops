{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourcePackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "sourceSystemId",
    "sourceRunId",
    "outcomeRevisionId",
    "exportedAt",
    "content",
    "redactionConfirmedAt",
    "contentSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sourceSystemId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sourceRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "outcomeRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redactedQuestion",
        "redactedSummary",
        "outcomeStatus"
      ],
      "properties": {
        "redactedQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "redactedSummary": {
          "type": "string",
          "maxLength": 1000
        },
        "outcomeStatus": {
          "enum": [
            "RESOLVED",
            "PARTIALLY_RESOLVED",
            "UNRESOLVED",
            "UNCONFIRMED"
          ]
        }
      }
    },
    "redactionConfirmedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
